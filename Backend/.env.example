# Llaves JWT ES256 (PEM; usa \\n para saltos de línea si se configura en una variable)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Anillo de llaves de cifrado: objeto JSON con valores Base64 de 32 bytes
DATA_ENC_KEYS=

# Llave HMAC para índices ciegos, codificada en Base64 (mínimo 32 bytes)
BLIND_INDEX_KEY=
