# Configuracion obligatoria
DATABASE_URL=postgresql+asyncpg://usuario:password@localhost:5432/internet_cafe
SECRET_KEY=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO

# Configuracion general
APP_NAME=Internet Cafe API
FRONTEND_BASE_URL=http://localhost:5173

# Llaves JWT ES256 (PEM; opcionales si se usan archivos locales)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Anillo de llaves de cifrado: JSON con valores Base64 de 32 bytes
DATA_ENC_KEYS=

# Llave HMAC para indices ciegos en Base64 (minimo 32 bytes)
BLIND_INDEX_KEY=
